[Unit]
Description=ScholarCheck web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scholarcheck
Group=scholarcheck
WorkingDirectory=/opt/scholarcheck/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/scholarcheck/scholarcheck.env
ExecStart=/opt/scholarcheck/current/.venv/bin/python -m scholarcheck.web --host ${SCHOLARCHECK_HOST} --port ${SCHOLARCHECK_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
